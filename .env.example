# 复制这份文件为 .env，填入真实值。.env 永远不会进仓库。
#   cp .env.example .env

# 必填：在 https://platform.deepseek.com 的「API keys」页面创建
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：默认值如下，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：采样温度，0 最稳定，1 最发散
LLM_TEMPERATURE=1.0

# 可选：超时与重试
# 只有一个超时参数：urllib 分不开「连接超时」和「读取超时」，这是它的限制。
LLM_READ_TIMEOUT=90
LLM_MAX_RETRIES=2

# 可选：每次最多发多少条消息给模型，超了从最早的开始丢
# 想亲眼看见裁剪发生，改成 6 聊几轮；想关掉裁剪，改成 0
MAX_CONTEXT_MESSAGES=20

# 可选：历史超长时，把早期对话压成摘要，至少保留多少条原文
# 0 = 关闭摘要，退回「直接丢掉旧对话」的老行为
# 想亲眼看见压缩发生，改成 8 聊几轮，会看到「[摘要] 早期对话已压缩」的提示
SUMMARY_KEEP_RECENT=8

# 可选：单价（元 / 百万 token）
# 去 DeepSeek 官网的「模型 & 价格」页查当前数字自己填，不要凭记忆写，价格会变。
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
